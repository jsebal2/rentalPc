generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model notification_log {
  id        Int      @id @default(autoincrement())
  user_id   Int
  notice_id Int
  sent_at   DateTime @default(now())

  user   user   @relation(fields: [user_id], references: [user_id], map: "fk_notification_user")
  notice notice @relation(fields: [notice_id], references: [notice_id], map: "fk_notification_notice")

  @@index([user_id])
  @@index([notice_id])
}

model notice_file {
  file_id       Int      @id @default(autoincrement())
  notice_id     Int
  file_path     String   @db.VarChar(255)
  original_name String?  @db.VarChar(255) // 사용자가 업로드한 실제 파일명
  uploaded_at   DateTime @default(now())  // 업로드 시각

  notice notice @relation(fields: [notice_id], references: [notice_id], map: "fk_notice_file_notice")

  @@index([notice_id])
}

model qna {
  qna_id      Int        @id @default(autoincrement())
  user_id     Int
  seller_id   Int
  title       String
  question    String     @db.Text
  answer      String?    @db.Text
  status      qna_status @default(UNANSWERED)
  created_at  DateTime   @default(now())
  answered_at DateTime?

  user   user @relation("QnaUser", fields: [user_id], references: [user_id], map: "fk_qna_user")
  seller user @relation("QnaSeller", fields: [seller_id], references: [user_id], map: "fk_qna_seller")

  @@index([user_id])
  @@index([seller_id], map: "fk_qna_seller")
}

model notice {
  notice_id  Int         @id @default(autoincrement())
  admin_id   Int
  title      String      @db.VarChar(100)
  content    String      @db.Text
  type       notice_type
  file_path  String?     @db.VarChar(255)
  pinned     Boolean?    @default(false)
  created_at DateTime?   @default(now()) @db.DateTime(0)
  user       user        @relation(fields: [admin_id], references: [user_id])

  files         notice_file[]
  notifications notification_log[]

  @@index([admin_id])
}

model payment {
  payment_id Int             @id @default(autoincrement())
  user_id    Int
  rental_id  Int
  amount     Int
  method     payment_method?
  status     payment_status?
  paid_at    DateTime?       @db.DateTime(0)
  user       user            @relation(fields: [user_id], references: [user_id])
  rental     rental          @relation(fields: [rental_id], references: [rental_id])

  @@index([rental_id])
  @@index([user_id])
}

model pc {
  pc_id        Int              @id @default(autoincrement())
  pcName       String           @default("알수없음") @db.VarChar(100)
  manufacturer String?          @db.VarChar(50)
  cpu          String?          @db.VarChar(50)
  ram          String?          @db.VarChar(50)
  ssd          String?          @db.VarChar(50)
  location     String?          @db.VarChar(100)
  graphic      String?          @db.VarChar(50)
  state        pc_state?
  power_status pc_power_status?
  user_id      Int?
  renter_id    Int?

  rental_status RentalStatus? @default(AVAILABLE)
  price         Int?
  reg_date      DateTime?     @default(now()) @db.DateTime(0)
  memo          String?       @db.VarChar(255)

  user   user? @relation(fields: [user_id], references: [user_id])
  renter user? @relation("RenterRelation", fields: [renter_id], references: [user_id])

  rental             rental[]
  purchase_request   purchase_request[]
  transaction        transaction[]
  rental_extensions  rental_extension[]

  @@index([user_id])
  @@index([renter_id])
}

model rental {
  rental_id  Int            @id @default(autoincrement())
  user_id    Int
  pc_id      Int
  start_date DateTime?      @db.DateTime(0)
  end_date   DateTime?      @db.DateTime(0)
  auto_renew Boolean?       @default(false)
  status     rental_status? @default(PENDING)
  created_at DateTime       @default(now()) @db.DateTime(0)
  payment    payment[]
  user       user           @relation(fields: [user_id], references: [user_id])
  pc         pc             @relation(fields: [pc_id], references: [pc_id])

  @@index([pc_id])
  @@index([user_id])
}

model user {
  user_id            Int         @id @default(autoincrement())
  name               String      @db.VarChar(100)
  email              String      @unique @db.VarChar(100)
  password           String      @db.VarChar(255)
  phone              String?     @db.VarChar(20)
  role               user_role   @default(Customer)
  status             user_status @default(ACTIVE)
  two_factor_enabled Boolean?    @default(false)
  join_date          DateTime?   @default(now()) @db.DateTime(0)
  last_login         DateTime?   @db.DateTime(0)

  notice           notice[]
  payment          payment[]
  pc               pc[]
  rental           rental[]
  purchase_request purchase_request[] @relation("BuyerPurchase")
  sales            transaction[]      @relation("UserSeller")
  purchase         transaction[]      @relation("UserBuyer")
  lead_request     lead_request[]

  rented_pcs        pc[]               @relation("RenterRelation")
  notification_logs notification_log[]

  sentFollowRequests  follow_request[]  @relation("RequesterRelation")
  receivedFollowRequests  follow_request[]  @relation("ReceiverRelation")

  notifications notification[]

  followsAsSeller follow[] @relation("seller")
  followsAsBuyer  follow[] @relation("buyer")
  
  qnas_as_customer qna[] @relation("QnaUser")
  qnas_as_seller   qna[] @relation("QnaSeller")

  rental_extensions_requested rental_extension[] @relation("ExtensionRequester") 
  rental_extensions_processed rental_extension[] @relation("ExtensionSeller")     
  
  seller_profile seller_profile?
}

model seller_profile {
  id                 Int      @id @default(autoincrement())
  user_id            Int      @unique
  business_name      String?
  introduction_title String?   @db.VarChar(500)
  introduction_content String? @db.VarChar(500)
  business_number    String?   @db.VarChar(20)
  business_license   String?   @db.VarChar(255)
  contact_phone      String?   @db.VarChar(20)
  contact_email      String?   @db.VarChar(100)
  company_address    String?   @db.VarChar(255)
  bank_name          String?   @db.VarChar(50)
  bank_account_number String?  @db.VarChar(50)
  account_holder     String?   @db.VarChar(50)
  verified_at        DateTime?
  last_sale_at       DateTime?

  user user @relation(fields: [user_id], references: [user_id])
  images  seller_profile_image[]
}

model seller_profile_image {
  id          Int      @id @default(autoincrement())
  profile_id  Int
  file_path   String   @db.VarChar(255) // 실제 저장 경로
  original_name String? @db.VarChar(255)
  uploaded_at DateTime @default(now())

  profile seller_profile @relation(fields: [profile_id], references: [id])

  @@index([profile_id])
}


model purchase_request {
  purchase_request_id Int                   @id @default(autoincrement())
  pc_id               Int
  buyer_id            Int
  status              PurchaseRequestStatus @default(PENDING)
  requested_at        DateTime              @default(now())
  responded_at        DateTime?

  pc    pc   @relation(fields: [pc_id], references: [pc_id])
  buyer user @relation("BuyerPurchase", fields: [buyer_id], references: [user_id])

  transaction transaction? @relation("RequestTransaction")

  @@index([pc_id])
  @@index([buyer_id])
}

model follow_request {
  id          Int      @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  approved    Boolean  @default(false)
  requestedAt DateTime @default(now())
  approvedAt  DateTime?

  requester user @relation("RequesterRelation", fields: [requesterId], references: [user_id])
  receiver  user @relation("ReceiverRelation", fields: [receiverId], references: [user_id])

  @@index([requesterId])
  @@index([receiverId])
  @@unique([requesterId, receiverId])
}

model follow {
  id        Int      @id @default(autoincrement())
  seller_id   Int
  buyer_id   Int
  createdAt DateTime @default(now())

  seller user @relation("seller", fields: [seller_id], references: [user_id])
  buyer user @relation("buyer", fields: [buyer_id], references: [user_id])

  @@unique([seller_id, buyer_id])
}

model transaction {
  transaction_id Int               @id @default(autoincrement())
  pc_id          Int
  seller_id      Int
  buyer_id       Int
  request_id     Int               @unique
  transaction_at DateTime          @default(now())
  status         TransactionStatus @default(COMPLETED)

  pc      pc               @relation(fields: [pc_id], references: [pc_id])
  seller  user             @relation("UserSeller", fields: [seller_id], references: [user_id])
  buyer   user             @relation("UserBuyer", fields: [buyer_id], references: [user_id])
  request purchase_request @relation("RequestTransaction", fields: [request_id], references: [purchase_request_id])

  @@index([pc_id])
  @@index([seller_id])
  @@index([buyer_id])
}

model lead_request {
  lead_request_id Int      @id @default(autoincrement())
  name            String?
  phone           String?
  email           String?
  note            String?
  created_at      DateTime @default(now())
  user_id         Int?
  user            user?    @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

model rental_extension {
  extension_id   Int             @id @default(autoincrement())
  pc_id          Int
  user_id        Int             // 요청자
  seller_id       Int?
  original_end   DateTime?       // 현재 예상 종료일 (nullable로 두어도 무방)
  requested_end  DateTime        // 요청하는 새로운 종료일
  status         extension_status @default(PENDING)
  requested_at   DateTime        @default(now())
  processed_at   DateTime?

  pc    pc    @relation(fields: [pc_id], references: [pc_id])
  user  user  @relation("ExtensionRequester", fields: [user_id], references: [user_id])
  seller user? @relation("ExtensionSeller", fields: [seller_id], references: [user_id])

  @@index([pc_id])
  @@index([user_id])
  @@index([seller_id])
}

model notification {
  notification_id Int        @id @default(autoincrement())
  user_id         Int        // 알림 수신자
  title           String     @db.VarChar(100)
  message         String     @db.Text
  type            notif_type @default(INFO)
  is_read         Boolean    @default(false)
  created_at      DateTime   @default(now())

  user user @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

enum notice_type {
  GENERAL
  MAINTENANCE
  UPDATE
  FAQ
}

enum payment_method {
  CARD
  BANK_TRANSFER
  PAYPAL
}

enum pc_state {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum payment_status {
  PENDING
  PAID
  FAILED
}

enum pc_power_status {
  ON
  OFF
}

enum user_role {
  Customer
  Seller
  Admin
}

enum rental_status {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum user_status {
  ACTIVE
  INACTIVE
  BANNED
}

enum RentalStatus {
  AVAILABLE
  RENTED
  RESERVED
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum qna_status {
  UNANSWERED
  ANSWERED
  CLOSED
}

enum manufacturer_type {
  INTEL
  AMD
}

enum extension_status {
  PENDING
  APPROVED
  REJECTED
}

enum notif_type {
  INFO
  ALERT
  WARNING
  SYSTEM
}
